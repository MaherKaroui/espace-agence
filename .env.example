# Copier en `.env` et renseigner les valeurs.
# Ces quatre variables sont publiques (la cle publishable est embarquee
# dans le bundle client par Vite) : la protection des donnees repose sur
# les policies RLS de Supabase, pas sur leur confidentialite.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# SECRET - ne jamais commiter. Defini uniquement cote hebergeur.
# SUPABASE_SERVICE_ROLE_KEY=
